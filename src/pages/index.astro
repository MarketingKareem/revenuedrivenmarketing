---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<BaseLayout
	title="PPC Management Focused on Revenue, Not Just Clicks"
	description="Google Ads and Meta Ads management built around attribution and revenue, not vanity metrics. Audits, teardowns, and hands-on account management."
>
	<section class="hero">
		<p class="eyebrow">Google Ads &middot; Meta Ads &middot; Revenue Attribution</p>
		<h1>Your ads are spending money. Are they actually driving revenue?</h1>
		<p class="lede">
			<!-- TODO(Kareem): swap in your real years of experience / niche once finalized -->
			I run Google Ads and Meta Ads accounts with revenue attribution as the starting point, not
			an afterthought &mdash; so budget goes where it actually converts, not just where it gets
			clicks.
		</p>
		<div class="cta-row">
			<a class="btn primary" href="/contact/">Get a free account audit</a>
			<a class="btn" href="/about/">How I work</a>
		</div>
	</section>

	<section class="posts">
		<h2>Latest from the blog</h2>
		{
			posts.length === 0 ? (
				<p class="muted">First posts coming soon.</p>
			) : (
				<ul>
					{posts.map((post) => (
						<li>
							<a href={`/blog/${post.id}/`}>{post.data.title}</a>
							<p>{post.data.description}</p>
						</li>
					))}
				</ul>
			)
		}
		<a class="see-all" href="/blog/">See all posts &rarr;</a>
	</section>
</BaseLayout>

<style>
	.hero {
		padding: 1.5rem 0 3.5rem;
	}
	.eyebrow {
		text-transform: uppercase;
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		color: var(--color-accent);
		margin: 0 0 1rem;
	}
	.hero h1 {
		font-size: 2.5rem;
		max-width: 20ch;
		margin: 0 0 1.25rem;
		color: var(--color-text);
	}
	.lede {
		font-size: 1.15rem;
		max-width: 60ch;
	}
	.cta-row {
		display: flex;
		gap: 1rem;
		margin-top: 1.75rem;
		flex-wrap: wrap;
	}
	.btn {
		display: inline-block;
		padding: 0.75rem 1.5rem;
		border-radius: var(--radius);
		text-decoration: none;
		font-weight: 600;
		border: 1px solid var(--color-accent);
		color: var(--color-accent);
		transition: background 0.15s ease;
	}
	.btn:hover {
		background: var(--color-bg-subtle);
		color: var(--color-accent-hover);
	}
	.btn.primary {
		background: var(--color-accent);
		color: #fff;
	}
	.btn.primary:hover {
		background: var(--color-accent-hover);
		color: #fff;
	}
	.posts {
		border-top: 1px solid var(--color-border);
		padding-top: 2.5rem;
	}
	.posts ul {
		list-style: none;
		padding: 0;
	}
	.posts li {
		margin-bottom: 1.5rem;
	}
	.posts li a {
		font-weight: 600;
		font-size: 1.05rem;
		text-decoration: none;
		color: var(--color-text);
	}
	.posts li a:hover {
		color: var(--color-accent);
	}
	.posts li p {
		margin: 0.35rem 0 0;
	}
	.see-all {
		font-weight: 600;
		text-decoration: none;
	}
	.muted {
		color: var(--color-text-muted);
	}
</style>
