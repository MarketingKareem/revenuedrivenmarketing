---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import FAQSection from '../components/FAQSection.astro';
import Testimonials from '../components/Testimonials.astro';
import CaseStudies from '../components/CaseStudies.astro';
import Guarantee from '../components/Guarantee.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);

// TODO(Kareem): drop in your real numbers here. Left honest and vague on
// purpose rather than inventing figures.
const stats = [
	{ value: 'Years', label: 'Managing Live Ad Accounts' },
	{ value: 'Real Dollars', label: 'In Ad Spend Managed, Not a Sandbox' },
	{ value: 'Google + Meta', label: 'Platforms We Run Daily' },
	{ value: 'Multiple Industries', label: 'Healthcare, Legal, Home Services, and More' },
];

const problems = [
	{
		icon: 'alert-triangle' as const,
		name: "Conversion Tracking That's Quietly Wrong",
		desc: 'Duplicate counting, misfired events, and inflated numbers are common in accounts nobody has actually audited. If the tracking is wrong, everything built on top of it is wrong too.',
	},
	{
		icon: 'trending-up' as const,
		name: 'Performance Max Eating Brand Search',
		desc: 'PMax can be a real growth channel, or a quiet way to pay for traffic you were already getting for free. Most accounts never check which one is happening.',
	},
	{
		icon: 'shuffle' as const,
		name: "Platforms That Don't Agree With Each Other",
		desc: 'Google Ads, Meta Ads, and GA4 all use different attribution windows and counting methods. Left alone, none of them match your actual revenue.',
	},
	{
		icon: 'refresh' as const,
		name: 'Creative That Stalls After Month One',
		desc: 'Strong early performance that quietly decays is usually fatigue, not a bad channel. Most accounts stop testing right when testing matters most.',
	},
];

const services = [
	{
		icon: 'target' as const,
		name: 'PPC Management',
		desc: 'The full picture across every platform, structured around revenue, not spend.',
		href: '/ppc-management/',
	},
	{
		icon: 'search' as const,
		name: 'Google Ads Management',
		desc: 'Search, Shopping, and Performance Max, structured around what actually converts, not platform-recommended defaults.',
		href: '/google-ads-management/',
	},
	{
		icon: 'share' as const,
		name: 'Meta Ads Management',
		desc: "Facebook and Instagram campaigns built for revenue, with creative and audience testing that doesn't stall out after week two.",
		href: '/meta-ads-management/',
	},
	{
		icon: 'bar-chart' as const,
		name: 'Revenue Attribution & Analytics',
		desc: 'GA4, conversion tracking, and multi-touch attribution set up correctly, so the numbers you optimize against are actually true.',
		href: '/revenue-attribution/',
	},
	{
		icon: 'clipboard-check' as const,
		name: 'Account Audits & Teardowns',
		desc: "A full diagnostic of what's broken, what's wasted, and what's working before you spend another dollar.",
		href: '/account-audits/',
	},
];

const process = [
	{
		icon: 'search-check' as const,
		step: '01',
		name: 'Audit',
		desc: "We tear the account down to see what's actually happening: tracking accuracy, wasted spend, structural issues the platform dashboard won't show you.",
	},
	{
		icon: 'wrench' as const,
		step: '02',
		name: 'Rebuild',
		desc: "Fix what's broken first: tracking, structure, targeting, before touching a single bid.",
	},
	{
		icon: 'trending-up' as const,
		step: '03',
		name: 'Scale',
		desc: "Once the foundation is honest, we scale what's proven to convert and cut what isn't.",
	},
];

const fitFor = [
	'You are spending real money on Google Ads or Meta Ads and cannot fully trust the numbers you are seeing.',
	'You have never had an outside, independent look at your account since it was first set up.',
	'You want an agency that will tell you to spend less when that is the honest answer.',
	'You are tired of reporting that highlights clicks and impressions instead of revenue.',
];

const notFitFor = [
	'You are looking for the cheapest possible option regardless of results.',
	'You want an agency that will never say no to a request, even a bad one.',
	'You are not running any real ad budget yet and are only exploring options.',
];

const faqs = [
	{
		q: 'What Is a Performance Marketing Agency?',
		a: 'An agency that manages paid advertising with revenue and cost per acquisition as the measure of success, not clicks or impressions. The distinction matters because platform-reported metrics can look great while actual revenue stays flat.',
	},
	{
		q: 'How Is This Different From a Traditional Marketing Agency?',
		a: 'Traditional agencies often bundle branding, content, and paid media together with broad, hard-to-measure goals. This is narrower and more accountable: Google Ads and Meta Ads, measured against revenue, with a free audit before anything changes.',
	},
	{
		q: 'Do You Work With Small Businesses?',
		a: "Yes, as long as there is enough real ad spend for ongoing management and testing to make sense. If your budget is too small for that, we'll say so honestly during the audit rather than take on an account that can't succeed.",
	},
	{
		q: 'What Platforms Do You Manage?',
		a: 'Primarily Google Ads and Meta Ads (Facebook and Instagram). See the PPC Management overview for how we think about running both together.',
	},
	{
		q: 'How Do I Know If My Ad Accounts Need a Second Look?',
		a: "If you cannot clearly explain what your ad spend produced last month in actual revenue, or nobody has checked your conversion tracking since it was first set up, that's usually enough reason on its own.",
	},
	{
		q: 'What Happens After I Request a Free Audit?',
		a: "We review your account, tracking setup, and reporting, then walk you through exactly what we found. No pressure to sign anything, and no changes are made to your account during the audit itself.",
	},
];
---

<BaseLayout
	title="Performance Marketing Agency Focused on Revenue, Not Just Clicks"
	description="Revenue Driven Marketing is a performance marketing agency running Google Ads and Meta Ads on attribution first, vanity metrics never. Audits, teardowns, and hands-on management."
>
	<section class="hero">
		<div class="hero-inner">
			<p class="eyebrow">Performance Marketing Agency</p>
			<h1>Your Ads Are Spending Money. Are They Actually Driving Revenue?</h1>
			<p class="lede">
				Revenue Driven Marketing runs Google Ads and Meta Ads accounts with attribution as the
				starting point, not an afterthought, so budget goes where it actually converts, not just
				where it gets clicks.
			</p>
			<div class="cta-row">
				<a class="btn primary" href="/contact/">Get a Free Account Audit</a>
				<a class="btn ghost" href="#process">See How We Work</a>
			</div>
		</div>
	</section>

	<section class="stats">
		<div class="stats-grid">
			{
				stats.map((s) => (
					<div class="stat">
						<span class="stat-value">{s.value}</span>
						<span class="stat-label">{s.label}</span>
					</div>
				))
			}
		</div>
	</section>

	<section class="problems">
		<h2>What's Actually Going Wrong in Most Ad Accounts</h2>
		<p class="section-lede">
			Not bad luck. The same handful of problems, over and over, in accounts nobody has actually
			looked at closely.
		</p>
		<div class="grid">
			{
				problems.map((p) => (
					<div class="card">
						<div class="card-icon">
							<Icon name={p.icon} />
						</div>
						<h3>{p.name}</h3>
						<p>{p.desc}</p>
					</div>
				))
			}
		</div>
		<a class="mid-cta" href="/contact/">Find Out What's Actually Happening in Your Account &rarr;</a>
	</section>

	<section class="services">
		<h2>What We Do</h2>
		<div class="grid">
			{
				services.map((service) => (
					<a class="card" href={service.href}>
						<div class="card-icon">
							<Icon name={service.icon} />
						</div>
						<h3>{service.name} &rarr;</h3>
						<p>{service.desc}</p>
					</a>
				))
			}
		</div>
	</section>

	<section class="process" id="process">
		<h2>How We Work</h2>
		<div class="grid">
			{
				process.map((p) => (
					<div class="step">
						<div class="card-icon">
							<Icon name={p.icon} />
						</div>
						<span class="step-num">{p.step}</span>
						<h3>{p.name}</h3>
						<p>{p.desc}</p>
					</div>
				))
			}
		</div>
	</section>

	<section class="fit">
		<div class="fit-grid">
			<div>
				<h2>This Is a Fit If</h2>
				<ul class="fit-list yes">
					{fitFor.map((item) => <li>{item}</li>)}
				</ul>
			</div>
			<div>
				<h2>This Isn't a Fit If</h2>
				<ul class="fit-list no">
					{notFitFor.map((item) => <li>{item}</li>)}
				</ul>
			</div>
		</div>
	</section>

	<Testimonials />

	<Guarantee />

	<section class="cta-band">
		<div class="cta-band-inner">
			<h2>Ready to See What Your Ad Account Is Actually Doing?</h2>
			<a class="btn primary large" href="/contact/">Get a Free Audit</a>
		</div>
	</section>

	<CaseStudies />

	<FAQSection items={faqs} />

	<section class="posts">
		<h2>Latest From the Blog</h2>
		{
			posts.length === 0 ? (
				<p class="muted">First posts coming soon.</p>
			) : (
				<ul>
					{posts.map((post) => (
						<li>
							<a href={`/blog/${post.id}/`}>{post.data.title}</a>
							<p>{post.data.description}</p>
						</li>
					))}
				</ul>
			)
		}
		<a class="see-all" href="/blog/">See All Posts &rarr;</a>
	</section>
</BaseLayout>

<style>
	/* Full-bleed section technique: break out of main's centered max-width */
	.hero,
	.cta-band {
		width: auto;
		margin-inline: calc(50% - 50vw);
		background: #0b0d12;
		color: #f5f6fa;
	}
	.hero {
		margin-top: -3rem;
		padding: 5.5rem 1.5rem 5rem;
	}
	.hero-inner,
	.cta-band-inner {
		max-width: 960px;
		margin: 0 auto;
	}
	.eyebrow {
		text-transform: uppercase;
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		color: #7ba0ff;
		margin: 0 0 1.25rem;
	}
	.hero h1 {
		font-size: 3rem;
		max-width: 18ch;
		margin: 0 0 1.5rem;
		color: #fff;
	}
	.hero .lede {
		font-size: 1.2rem;
		max-width: 58ch;
		color: #c2c5d6;
	}
	.cta-row {
		display: flex;
		gap: 1rem;
		margin-top: 2rem;
		flex-wrap: wrap;
	}
	.btn {
		display: inline-block;
		padding: 0.85rem 1.75rem;
		border-radius: var(--radius);
		text-decoration: none;
		font-weight: 700;
		border: 1px solid var(--color-accent);
		color: var(--color-accent);
		transition:
			background 0.15s ease,
			border-color 0.15s ease,
			color 0.15s ease;
	}
	.btn:hover {
		background: var(--color-bg-subtle);
		color: var(--color-accent-hover);
	}
	.btn.primary {
		background: var(--color-accent);
		color: #fff;
	}
	.btn.primary:hover {
		background: var(--color-accent-hover);
		color: #fff;
	}
	.btn.large {
		padding: 1rem 2.25rem;
		font-size: 1.05rem;
	}
	.btn.ghost {
		border-color: #454a5e;
		color: #f5f6fa;
	}
	.btn.ghost:hover {
		background: #171922;
		border-color: #7ba0ff;
		color: #fff;
	}

	.stats {
		padding: 3rem 0;
		border-bottom: 1px solid var(--color-border);
	}
	.stats-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 1.5rem;
	}
	.stat {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
	}
	.stat-value {
		font-size: 1.3rem;
		font-weight: 800;
		color: var(--color-accent);
	}
	.stat-label {
		font-size: 0.85rem;
		color: var(--color-text-muted);
	}

	.problems,
	.services,
	.process,
	.fit {
		padding: 4.5rem 0;
		border-top: 1px solid var(--color-border);
	}
	.problems h2,
	.services h2,
	.process h2,
	.posts h2 {
		font-size: 1.75rem;
		margin: 0 0 0.75rem;
	}
	.section-lede {
		color: var(--color-text-muted);
		max-width: 60ch;
		margin: 0 0 2.5rem;
	}
	.services h2,
	.process h2 {
		margin-bottom: 2.5rem;
	}
	.grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1.75rem;
	}
	.card {
		padding: 1.75rem;
		border: 1px solid var(--color-border);
		border-radius: 12px;
		background: var(--color-bg-subtle);
		text-decoration: none;
		display: block;
		transition: border-color 0.15s ease;
	}
	a.card:hover {
		border-color: var(--color-accent);
	}
	.card-icon {
		width: 40px;
		height: 40px;
		display: flex;
		align-items: center;
		justify-content: center;
		border-radius: 8px;
		background: #e8ecfb;
		color: var(--color-accent);
		margin-bottom: 1rem;
	}
	.card h3 {
		margin: 0 0 0.6rem;
		font-size: 1.1rem;
		color: var(--color-text);
	}
	a.card h3 {
		color: var(--color-accent);
	}
	.card p {
		margin: 0;
		font-size: 0.95rem;
	}
	.mid-cta {
		display: inline-block;
		margin-top: 2rem;
		font-weight: 600;
		text-decoration: none;
	}

	.process .grid {
		grid-template-columns: repeat(3, 1fr);
	}
	.step {
		padding: 1.75rem;
		border: 1px solid var(--color-border);
		border-radius: 12px;
	}
	.step-num {
		display: block;
		font-size: 0.85rem;
		font-weight: 800;
		color: var(--color-accent);
		letter-spacing: 0.05em;
		margin-bottom: 0.75rem;
	}
	.step h3 {
		margin: 0 0 0.6rem;
		font-size: 1.15rem;
	}
	.step p {
		margin: 0;
		font-size: 0.95rem;
	}

	.fit-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 2.5rem;
	}
	.fit h2 {
		font-size: 1.3rem;
		margin: 0 0 1.25rem;
	}
	.fit-list {
		list-style: none;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
	}
	.fit-list li {
		padding-left: 1.75rem;
		position: relative;
		color: var(--color-text-muted);
	}
	.fit-list.yes li::before {
		content: '✓';
		position: absolute;
		left: 0;
		color: #0a8a4a;
		font-weight: 800;
	}
	.fit-list.no li::before {
		content: '✕';
		position: absolute;
		left: 0;
		color: #b00020;
		font-weight: 800;
	}

	.cta-band {
		padding: 4.5rem 1.5rem;
		text-align: center;
	}
	.cta-band h2 {
		color: #fff;
		font-size: 2rem;
		max-width: 24ch;
		margin: 0 auto 2rem;
	}

	.posts {
		padding-top: 4.5rem;
		border-top: 1px solid var(--color-border);
	}
	.posts ul {
		list-style: none;
		padding: 0;
	}
	.posts li {
		margin-bottom: 1.5rem;
	}
	.posts li a {
		font-weight: 600;
		font-size: 1.05rem;
		text-decoration: none;
		color: var(--color-text);
	}
	.posts li a:hover {
		color: var(--color-accent);
	}
	.posts li p {
		margin: 0.35rem 0 0;
	}
	.see-all {
		font-weight: 600;
		text-decoration: none;
	}
	.muted {
		color: var(--color-text-muted);
	}

	@media (max-width: 640px) {
		.hero h1 {
			font-size: 2.1rem;
		}
		.grid,
		.process .grid,
		.fit-grid {
			grid-template-columns: 1fr;
		}
		.stats-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}
</style>
