---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import FAQSection from '../components/FAQSection.astro';
import Testimonials from '../components/Testimonials.astro';
import CaseStudies from '../components/CaseStudies.astro';
import Guarantee from '../components/Guarantee.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);

const stats = [
	{ value: '10+ Years', label: 'Managing Live Ad Accounts' },
	{ value: '$10M+', label: 'In Ad Spend Managed, Not a Sandbox' },
	{ value: 'Google + Meta', label: 'Platforms We Run Daily' },
	{ value: 'Multiple Industries', label: 'Healthcare, Legal, Home Services, and More' },
];

const reconciliation = [
	{ label: 'Google Ads Reports', value: 340, display: '340 Conversions' },
	{ label: 'Meta Ads Reports', value: 290, display: '290 Conversions' },
	{ label: 'Combined (What Most Reports Show)', value: 630, display: '630 Conversions', flag: true },
	{ label: 'Actual New Customers in the CRM', value: 410, display: '410 Customers', real: true },
];

const problems = [
	{
		icon: 'alert-triangle' as const,
		name: "Conversion Tracking That's Quietly Wrong",
		desc: 'Duplicate counting, misfired events, and inflated numbers are common in accounts nobody has actually audited. If the tracking is wrong, everything built on top of it is wrong too.',
	},
	{
		icon: 'trending-up' as const,
		name: 'Performance Max Eating Brand Search',
		desc: 'PMax can be a real growth channel, or a quiet way to pay for traffic you were already getting for free. Most accounts never check which one is happening.',
	},
	{
		icon: 'shuffle' as const,
		name: "Platforms That Don't Agree With Each Other",
		desc: 'Google Ads, Meta Ads, and GA4 all use different attribution windows and counting methods. Left alone, none of them match your actual revenue.',
	},
	{
		icon: 'refresh' as const,
		name: 'Creative That Stalls After Month One',
		desc: 'Strong early performance that quietly decays is usually fatigue, not a bad channel. Most accounts stop testing right when testing matters most.',
	},
];

const services = [
	{
		icon: 'target' as const,
		name: 'PPC Management',
		desc: 'Keyword and audience research, negative-keyword pruning, ad copy and creative testing, landing page CRO, and daily bid and budget management, run as one system across every platform instead of disconnected line items.',
		href: '/ppc-management/',
	},
	{
		icon: 'search' as const,
		name: 'Google Ads Management',
		desc: 'Search, Shopping, and Performance Max structured around match-type strategy and Quality Score, so bidding logic follows what actually converts instead of platform-recommended defaults.',
		href: '/google-ads-management/',
	},
	{
		icon: 'share' as const,
		name: 'Meta Ads Management',
		desc: "Facebook and Instagram campaigns built on lookalike and interest audiences, with a real creative-testing cadence so cost per result doesn't climb the moment an ad set fatigues.",
		href: '/meta-ads-management/',
	},
	{
		icon: 'bar-chart' as const,
		name: 'Revenue Attribution & Analytics',
		desc: 'GA4, deduplicated conversion tracking, and multi-touch attribution set up correctly across platforms, so the number you optimize against is your actual revenue, not an inflated one.',
		href: '/revenue-attribution/',
	},
	{
		icon: 'clipboard-check' as const,
		name: 'Account Audits & Teardowns',
		desc: "A full diagnostic of tracking accuracy, structural waste, and targeting errors before you spend another dollar. Free, with no obligation to work with us afterward.",
		href: '/account-audits/',
	},
];

const process = [
	{
		icon: 'search-check' as const,
		step: '01',
		name: 'Audit',
		desc: "We tear the account down before touching a single bid: whether conversion tracking is accurate, where structural waste is hiding (broad match with no negatives, ad sets competing with each other, Performance Max cannibalizing branded search), and whether the account is even structured to let good decisions get made. Free, no obligation.",
	},
	{
		icon: 'wrench' as const,
		step: '02',
		name: 'Rebuild',
		desc: "Fix tracking first, since every optimization decision downstream depends on it being accurate, then fix account structure and targeting. Bid adjustments on top of broken tracking just optimize toward the wrong number faster.",
	},
	{
		icon: 'trending-up' as const,
		step: '03',
		name: 'Scale',
		desc: "Once the foundation is honest, we scale what's proven to convert with a real testing cadence, and cut what isn't, even if it looks fine on platform-reported metrics but isn't producing revenue against the real number.",
	},
];

const fitFor = [
	'You are spending real money on Google Ads or Meta Ads and cannot fully trust the numbers you are seeing.',
	'You have never had an outside, independent look at your account since it was first set up.',
	'You want an agency that will tell you to spend less when that is the honest answer.',
	'You are tired of reporting that highlights clicks and impressions instead of revenue.',
];

const notFitFor = [
	'You are looking for the cheapest possible option regardless of results.',
	'You want an agency that will never say no to a request, even a bad one.',
	'You are not running any real ad budget yet and are only exploring options.',
];

const industries = [
	{
		name: 'Healthcare & Medical',
		desc: 'Compliance constraints shape what claims can appear in ad copy, and intent splits sharply between symptom research (low intent, expensive to chase) and provider comparison (high intent, worth bidding aggressively on). We build around that split instead of paying for every symptom search.',
	},
	{
		name: 'Legal & Professional Services',
		desc: 'Personal injury and family law sit in some of the most expensive cost-per-click markets in the country, sometimes $100 or more per click. At that price, negative-keyword discipline and landing page conversion rate matter more than bid strategy itself.',
	},
	{
		name: 'Home Services',
		desc: "HVAC, electrical, plumbing, and roofing live or die on local intent and speed. Someone searching \"emergency AC repair\" at 2pm is a different customer than someone researching maintenance tips, and one generic campaign wastes budget on the wrong one.",
	},
	{
		name: 'Real Estate & Property Management',
		desc: 'Search intent varies enormously by stage: an early browser researching neighborhoods looks nothing like someone ready to schedule a showing this week. Running one ad for both wastes budget on the wrong stage.',
	},
	{
		name: 'E-Commerce & Retail',
		desc: 'Accounts live or die on the split between prospecting (new customers, longer payback) and retargeting (near-buyers, immediate ROAS). Getting that split wrong is the most common reason an account looks profitable in aggregate while losing money on new customers.',
	},
	{
		name: 'Every Other Business Spending Real Money on Ads',
		desc: 'The actual qualifier for whether we can help is not your industry. It is whether you are running a meaningful Google Ads or Meta Ads budget and cannot fully trust the numbers you are seeing.',
	},
];

const pricingModels = [
	{
		tag: '%',
		name: 'Percentage of Ad Spend',
		range: '10–20%',
		desc: 'Scales naturally as your budget grows. Watch for agencies whose only incentive under this model is growing your spend, since their fee rises either way, whether results do or not.',
	},
	{
		tag: '$',
		name: 'Flat Monthly Retainer',
		range: '$1,000–$10,000+',
		desc: "Predictable to budget against, and doesn't create pressure to inflate spend. Needs to be scoped honestly against the actual complexity of your account and platforms.",
	},
	{
		tag: 'ROI',
		name: 'Performance-Based',
		range: 'Tied to Results',
		desc: 'Fees tied to leads, conversions, or revenue milestones. Sounds the most aligned on paper, but only works once conversion tracking is already clean enough to trust.',
	},
];

const faqs = [
	{
		q: 'What Is a Performance Marketing Agency?',
		a: 'An agency that manages paid advertising with revenue and cost per acquisition as the measure of success, not clicks or impressions. The distinction matters because platform-reported metrics can look great while actual revenue stays flat.',
	},
	{
		q: 'How Is This Different From a Traditional Marketing Agency?',
		a: 'Traditional agencies often bundle branding, content, and paid media together with broad, hard-to-measure goals. This is narrower and more accountable: Google Ads and Meta Ads, measured against revenue, with a free audit before anything changes.',
	},
	{
		q: 'Do You Work With Small Businesses?',
		a: "Yes, as long as there is enough real ad spend for ongoing management and testing to make sense. If your budget is too small for that, we'll say so honestly during the audit rather than take on an account that can't succeed.",
	},
	{
		q: 'What Platforms Do You Manage?',
		a: 'Primarily Google Ads and Meta Ads (Facebook and Instagram). See the PPC Management overview for how we think about running both together.',
	},
	{
		q: 'How Do I Know If My Ad Accounts Need a Second Look?',
		a: "If you cannot clearly explain what your ad spend produced last month in actual revenue, or nobody has checked your conversion tracking since it was first set up, that's usually enough reason on its own.",
	},
	{
		q: 'What Happens After I Request a Free Audit?',
		a: "We review your account, tracking setup, and reporting, then walk you through exactly what we found. No pressure to sign anything, and no changes are made to your account during the audit itself.",
	},
	{
		q: 'How Much Should I Budget for Google Ads or Meta Ads?',
		a: "It depends on your market and sales cycle, but as a rough floor, your monthly spend needs to be high enough that a single conversion is not a rounding error in the budget. We will give you a straight answer on whether your current or planned budget is realistic during the free audit, instead of a generic number that does not apply to your account.",
	},
	{
		q: "What's the Difference Between PPC and SEO?",
		a: 'PPC (Google Ads, Meta Ads) buys placement immediately and stops the moment you stop paying for it. SEO earns organic rankings over months and keeps working after you scale back investment, but takes much longer to show results. Most businesses benefit from both, but if you need revenue this quarter, PPC is the lever that moves fastest.',
	},
	{
		q: 'Do You Build and Optimize Landing Pages Too?',
		a: "Yes, when the landing page is the reason ad spend is not converting. We'll tell you plainly during the audit if that's your bottleneck, rather than just recommending more ad spend to compensate for a page that isn't converting.",
	},
	{
		q: 'How Quickly Will I See Results?',
		a: "Tracking and account-structure fixes usually surface within the first couple of weeks. Meaningful performance movement, more clicks actually turning into revenue, typically takes a full optimization cycle, generally 60 to 90 days, since the platforms need real conversion data to optimize against.",
	},
	{
		q: 'Do I Keep Ownership of My Ad Accounts and Data?',
		a: 'Yes, always. Your Google Ads and Meta Ads accounts, and all the historical data and conversion tracking inside them, belong to you, not to us. If we ever part ways, you keep everything exactly as it is.',
	},
	{
		q: 'Do You Require Long-Term Contracts?',
		a: "No. We work month to month and earn the relationship on results, not on a signed term. If we're not the right fit, you're free to leave with your accounts intact.",
	},
];
---

<BaseLayout
	title="Performance Marketing Agency Focused on Revenue, Not Just Clicks"
	description="Revenue Driven Marketing is a performance marketing agency running Google Ads and Meta Ads on attribution first, vanity metrics never. Audits, teardowns, and hands-on management."
>
	<section class="hero">
		<div class="hero-inner">
			<p class="eyebrow">Performance Marketing Agency</p>
			<h1>Your Ads Are Spending Money. Are They Actually Driving Revenue?</h1>
			<p class="lede">
				Revenue Driven Marketing runs Google Ads and Meta Ads accounts with attribution as the
				starting point, not an afterthought, so budget goes where it actually converts, not just
				where it gets clicks.
			</p>
			<div class="cta-row">
				<a class="btn primary" href="/contact/">Get a Free Account Audit</a>
				<a class="btn ghost" href="#process">See How We Work</a>
			</div>
		</div>
	</section>

	<section class="reconcile reveal">
		<p class="eyebrow dark">// Why Your Ads and Your Revenue Disagree</p>
		<h2>Why Your Google Ads and Meta Ads Numbers Don't Match Your Actual Revenue</h2>
		<div class="reconcile-body">
			<div class="reconcile-text">
				<p>
					If you've pulled your Google Ads and Meta Ads dashboards side by side and added up
					their reported conversions, then compared that number to what your CRM, order
					platform, or bank account actually shows, you've probably seen a gap. Not a rounding
					error. Often 20 to 40 percent, sometimes more. This is the single most common question
					we get asked during a free account audit, and it's not a sign that something is broken.
					It's how attribution is built to work by default.
				</p>
				<p>
					<strong>Attribution windows</strong> are the first mechanism. Every platform assigns a
					conversion credit window, a period of time after an ad interaction during which any
					resulting purchase gets counted as caused by that ad. Meta's default is a 7-day click
					and 1-day view window. Google Ads, on data-driven attribution, can credit conversions
					from clicks up to 30 days back. Run both at once and they will each claim credit for
					some of the same customers, because both windows are wide enough to overlap.
				</p>
				<p class="pull-stat">
					<span class="pull-num">20&ndash;40%</span>
					<span class="pull-label">Typical gap between summed platform-reported conversions and actual unique customers</span>
				</p>
				<p>
					<strong>Cross-device journeys</strong> compound this. A customer clicks a Meta ad on
					their phone, doesn't buy. Later, on a laptop, they search your brand name on Google and
					convert. Google Ads records a conversion. If Meta's pixel also picked up a view-through
					signal, Meta may record one too. Neither platform sees the other's data.
				</p>
				<p>
					The fix isn't picking one platform's number to trust. It's building a ground-truth
					measurement layer, usually GA4 configured correctly plus your actual CRM or order data,
					that both platforms feed into, so you have one number you actually believe.
				</p>
			</div>
			<div class="reconcile-visual" aria-label="Worked example: platform-reported conversions vs. actual customers">
				<p class="reconcile-visual-label">A Real Example, One Month</p>
				<div class="recon-bars">
					{
						reconciliation.map((r) => (
							<div class={`recon-row ${r.flag ? 'is-flag' : ''} ${r.real ? 'is-real' : ''}`}>
								<span class="recon-label">{r.label}</span>
								<div class="recon-track">
									<div class="recon-fill" style={`width: ${(r.value / 630) * 100}%`} />
								</div>
								<span class="recon-value">{r.display}</span>
							</div>
						))
					}
				</div>
				<p class="recon-caption">
					The 220-customer gap isn't fraud, it's double-counting plus modeled conversions
					platforms can't directly observe.
				</p>
			</div>
		</div>
	</section>

	<section class="platform-compare reveal">
		<p class="eyebrow dark">// How the Two Platforms Work Together</p>
		<h2>Google Ads vs. Meta Ads: How They Actually Work Together</h2>
		<div class="compare-grid">
			<div class="compare-cell">
				<h3>Google Ads Captures Demand That Already Exists</h3>
				<p>
					Someone typing a search because they have a need right now. Measured primarily on
					search intent and Quality Score, it's the fastest lever for revenue when someone is
					already looking for what you sell.
				</p>
			</div>
			<div class="compare-cell">
				<h3>Meta Ads Creates Demand From Attention</h3>
				<p>
					Someone scrolling with no active intent, shown an offer based on modeled interest or
					lookalike audiences built from your existing customers. Slower to pay back per dollar
					than high-intent search, but it reaches people search can't, since they haven't started
					looking yet.
				</p>
			</div>
		</div>
		<p class="compare-note">
			Run well together, Meta builds awareness and retargeting pools that make branded search
			cheaper over time, while Google Ads captures the high-intent demand Meta helped create. Run
			badly, they compete for credit on the same customers, which is exactly the attribution
			problem above.
		</p>
	</section>

	<section class="stats reveal">
		<div class="stats-grid">
			{
				stats.map((s) => (
					<div class="stat">
						<span class="stat-value">{s.value}</span>
						<span class="stat-label">{s.label}</span>
					</div>
				))
			}
		</div>
	</section>

	<section class="agency-def reveal">
		<p class="eyebrow dark">// What This Actually Means</p>
		<h2>What Is a Performance Marketing Agency?</h2>
		<div class="agency-def-body">
			<p>
				<strong>Performance marketing</strong> is advertising where every dollar is measured
				against a business outcome, revenue, cost per acquisition, return on ad spend, instead of
				against clicks or impressions. A performance marketing agency runs Google Ads and Meta Ads
				with that outcome as the starting assumption, not an afterthought bolted on with a
				reporting dashboard at the end of the month.
			</p>
			<p>
				That sounds like a small distinction until you look at how most accounts get managed. A
				traditional agency, or an in-house hire without dedicated bandwidth, tends to optimize for
				the metrics the platforms surface first: click-through rate, cost per click, impression
				share. Those numbers are real, but they describe activity, not outcome. An account can hit
				every platform-reported benchmark while actual revenue stays flat, because the conversions
				being counted don't match the customers actually paying you.
			</p>
			<p>
				<strong>PPC management</strong> is the operational discipline underneath performance
				marketing: keyword and audience research, negative-keyword pruning, ad copywriting and
				creative testing, landing page optimization, bid and budget management, and continuous A/B
				testing. Google Ads and Meta Ads each require their own expertise, since one is
				intent-based and the other interruption-based, and a good agency runs both as one
				coordinated budget rather than two disconnected line items competing for credit.
			</p>
			<p>
				The actual job is making sure the numbers you're optimizing against are true: clean
				conversion tracking, a defensible model for revenue attribution across platforms, and a
				monthly answer to a simple question, what did the ad spend actually produce, in dollars,
				not clicks.
			</p>
		</div>
	</section>

	<section class="problems reveal">
		<h2>What's Actually Going Wrong in Most Ad Accounts</h2>
		<p class="section-lede">
			Not bad luck. The same handful of problems, over and over, in accounts nobody has actually
			looked at closely.
		</p>
		<div class="ledger-grid">
			{
				problems.map((p) => (
					<div class="ledger-cell">
						<Icon name={p.icon} size={22} />
						<h3>{p.name}</h3>
						<p>{p.desc}</p>
					</div>
				))
			}
		</div>
		<p class="section-close">
			Running Google Ads and Meta Ads profitably at the same time is a full-time discipline split
			across two platforms that don't share a rulebook. The realistic alternative to an agency
			usually isn't "no management," it's a part-time in-house hire or a freelancer managing several
			unrelated accounts, both with a ramp-up cost while budget keeps getting spent regardless. The
			honest case for hiring one isn't that doing it yourself is impossible. It's a bet on speed: what
			a wasted quarter of underoptimized spend actually costs, compared to a management fee.
		</p>
		<a class="mid-cta" href="/contact/">Find Out What's Actually Happening in Your Account &rarr;</a>
	</section>

	<section class="services reveal">
		<h2>What We Do</h2>
		<div class="ledger-list">
			{
				services.map((service) => (
					<a class="service-row" href={service.href}>
						<span class="service-name">
							<Icon name={service.icon} size={20} />
							{service.name}
						</span>
						<span class="service-desc">{service.desc}</span>
						<span class="service-arrow" aria-hidden="true">&rarr;</span>
					</a>
				))
			}
		</div>
	</section>

	<section class="process reveal" id="process">
		<h2>How We Work</h2>
		<div class="process-grid">
			{
				process.map((p) => (
					<div class="step">
						<span class="step-num">{p.step}</span>
						<Icon name={p.icon} size={20} />
						<h3>{p.name}</h3>
						<p>{p.desc}</p>
					</div>
				))
			}
		</div>
	</section>

	<section class="industries reveal">
		<h2>Industries We Serve</h2>
		<p class="section-lede">
			Search intent and cost per click look different in every market. Here's where we've run
			profitable Google and Meta accounts, and adapted the playbook to fit.
		</p>
		<div class="ledger-grid industries-grid">
			{
				industries.map((ind) => (
					<div class="ledger-cell">
						<h3>{ind.name}</h3>
						<p>{ind.desc}</p>
					</div>
				))
			}
		</div>
	</section>

	<section class="pricing reveal">
		<p class="eyebrow dark">// How the Fee Actually Works</p>
		<h2>PPC Management Pricing: How It Actually Works</h2>
		<p class="section-lede">
			Most agencies don't publish pricing. Here's how the fee models actually work, since the
			model matters more than the headline number.
		</p>
		<div class="pricing-grid">
			{
				pricingModels.map((p) => (
					<div class="pricing-cell">
						<span class="pricing-tag">{p.tag}</span>
						<span class="pricing-range">{p.range}</span>
						<h3>{p.name}</h3>
						<p>{p.desc}</p>
					</div>
				))
			}
		</div>
		<p class="section-close">
			For most small and mid-sized businesses, all-in PPC investment (ad spend plus management fee
			combined) tends to run $2,000 to $10,000+ a month, though the right number depends entirely on
			your market's cost per click. We'll tell you honestly during the audit whether your planned
			budget is realistic, rather than quoting a number that doesn't apply to your account.
		</p>
	</section>

	<section class="fit reveal">
		<div class="fit-grid">
			<div>
				<h2>This Is a Fit If</h2>
				<ul class="fit-list yes">
					{fitFor.map((item) => <li>{item}</li>)}
				</ul>
			</div>
			<div>
				<h2>This Isn't a Fit If</h2>
				<ul class="fit-list no">
					{notFitFor.map((item) => <li>{item}</li>)}
				</ul>
			</div>
		</div>
	</section>

	<Testimonials />

	<Guarantee />

	<section class="cta-band">
		<div class="cta-band-inner">
			<h2>Ready to See What Your Ad Account Is Actually Doing?</h2>
			<a class="btn primary large" href="/contact/">Get a Free Audit</a>
		</div>
	</section>

	<CaseStudies />

	<FAQSection items={faqs} />

	<section class="posts">
		<h2>Latest From the Blog</h2>
		{
			posts.length === 0 ? (
				<p class="muted">First posts coming soon.</p>
			) : (
				<ul>
					{posts.map((post) => (
						<li>
							<a href={`/blog/${post.id}/`}>{post.data.title}</a>
							<p>{post.data.description}</p>
						</li>
					))}
				</ul>
			)
		}
		<a class="see-all" href="/blog/">See All Posts &rarr;</a>
	</section>
</BaseLayout>

<script>
	const revealEls = document.querySelectorAll('.reveal');
	if ('IntersectionObserver' in window && revealEls.length) {
		const io = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (entry.isIntersecting) {
						entry.target.classList.add('is-visible');
						io.unobserve(entry.target);
					}
				}
			},
			{ threshold: 0.12 },
		);
		revealEls.forEach((el) => io.observe(el));
	} else {
		revealEls.forEach((el) => el.classList.add('is-visible'));
	}
</script>

<style>
	/* Full-bleed section technique: break out of main's centered max-width */
	.hero,
	.cta-band {
		width: auto;
		margin-inline: calc(50% - 50vw);
		background: var(--ledger-navy);
		color: var(--ledger-ink-on-navy);
	}
	.hero {
		margin-top: -3rem;
		padding: 5.5rem 1.5rem 5rem;
	}
	.hero-inner,
	.cta-band-inner {
		max-width: 960px;
		margin: 0 auto;
	}
	.eyebrow {
		text-transform: uppercase;
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		color: var(--ledger-signal-pale);
		margin: 0 0 1.25rem;
	}
	.hero h1 {
		font-size: 3rem;
		max-width: 18ch;
		margin: 0 0 1.5rem;
		color: var(--ledger-paper-white);
	}
	.hero .lede {
		font-size: 1.2rem;
		max-width: 58ch;
		color: var(--ledger-ink-on-navy);
	}
	.cta-row {
		display: flex;
		gap: 1rem;
		margin-top: 2rem;
		flex-wrap: wrap;
	}
	.btn {
