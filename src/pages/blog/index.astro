---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { pillarLabels } from '../../lib/pillars';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout
	title="Blog"
	description="PPC audits, teardowns, and revenue-attribution breakdowns for Google Ads and Meta Ads."
>
	<h1>Blog</h1>

	{
		posts.length === 0 ? (
			<p>First posts coming soon.</p>
		) : (
			<ul class="post-list">
				{posts.map((post) => (
					<li>
						<a class="thumb" href={`/blog/${post.id}/`} tabindex="-1" aria-hidden="true">
							<img src={`/og/${post.data.pillar}.png`} alt="" width="1200" height="630" loading="lazy" />
						</a>
						<div>
							<span class="pillar">{pillarLabels[post.data.pillar]}</span>
							<a href={`/blog/${post.id}/`}>{post.data.title}</a>
							<p>{post.data.description}</p>
							<time datetime={post.data.pubDate.toISOString()}>
								{post.data.pubDate.toLocaleDateString('en-US', {
									year: 'numeric',
									month: 'long',
									day: 'numeric',
								})}
							</time>
						</div>
					</li>
				))}
			</ul>
		)
	}

	<style>
		h1 {
			font-size: 2rem;
			margin-bottom: 2rem;
		}
		.post-list {
			list-style: none;
			padding: 0;
		}
		.post-list li {
			border-bottom: 1px solid var(--color-border);
			padding: 1.75rem 0;
			display: flex;
			gap: 1.5rem;
			align-items: flex-start;
		}
		.thumb {
			flex-shrink: 0;
			width: 200px;
			border-radius: var(--radius);
			overflow: hidden;
			line-height: 0;
		}
		.thumb img {
			width: 100%;
			height: auto;
			display: block;
		}
		@media (max-width: 600px) {
			.post-list li {
				flex-direction: column;
			}
			.thumb {
				width: 100%;
			}
		}
		.post-list a {
			font-size: 1.2rem;
			font-weight: 600;
			text-decoration: none;
			color: var(--color-text);
		}
		.post-list a:hover {
			color: var(--color-accent);
		}
		.post-list p {
			margin: 0.4rem 0 0.5rem;
		}
		.pillar {
			display: block;
			font-size: 0.75rem;
			text-transform: uppercase;
			letter-spacing: 0.06em;
			color: var(--color-accent);
			font-weight: 700;
			margin-bottom: 0.4rem;
		}
		time {
			font-size: 0.85rem;
			color: var(--color-text-muted);
		}
	</style>
</BaseLayout>
