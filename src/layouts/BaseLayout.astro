---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
	title: string;
	description: string;
	image?: string;
}

const { title, description, image } = Astro.props;
const gtmId = import.meta.env.PUBLIC_GTM_ID;
const gscVerification = import.meta.env.PUBLIC_GSC_VERIFICATION;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = image ? new URL(image, Astro.site) : undefined;
const fullTitle = `${title} | Revenue Driven Marketing`;

const organizationSchema = {
	'@context': 'https://schema.org',
	'@type': 'ProfessionalService',
	name: 'Revenue Driven Marketing',
	url: 'https://revenuedrivenmarketing.com',
	description:
		'Performance marketing agency running Google Ads and Meta Ads on attribution first, not vanity metrics.',
	areaServed: 'US',
	priceRange: '$$',
	knowsAbout: [
		'Google Ads Management',
		'Meta Ads Management',
		'PPC Management',
		'Revenue Attribution',
		'Conversion Tracking',
	],
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="canonical" href={canonicalURL} />
		<meta name="generator" content={Astro.generator} />
		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		{gscVerification && <meta name="google-site-verification" content={gscVerification} />}

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Revenue Driven Marketing" />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		<meta name="twitter:title" content={fullTitle} />
		<meta name="twitter:description" content={description} />
		{ogImageURL ? (
			<>
				<meta property="og:image" content={ogImageURL} />
				<meta name="twitter:card" content="summary_large_image" />
				<meta name="twitter:image" content={ogImageURL} />
			</>
		) : (
			<meta name="twitter:card" content="summary" />
		)}

		<script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />

		{gtmId && (
			<script is:inline define:vars={{ gtmId }}>
				(function (w, d, s, l, i) {
					w[l] = w[l] || [];
					w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
					var f = d.getElementsByTagName(s)[0],
						j = d.createElement(s),
						dl = l != 'dataLayer' ? '&l=' + l : '';
					j.async = true;
					j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
					f.parentNode.insertBefore(j, f);
				})(window, document, 'script', 'dataLayer', gtmId);
			</script>
		)}
	</head>
	<body>
		{gtmId && (
			<noscript>
				<iframe
					src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`}
					height="0"
					width="0"
					style="display:none;visibility:hidden"
					title="Google Tag Manager"
				></iframe>
			</noscript>
		)}
		<Header />
		<main>
			<slot />
		</main>
		<Footer />
	</body>
</html>

<style is:global>
	@font-face {
		font-family: 'Barlow Condensed';
		src: url('/fonts/barlow-condensed-700.woff2') format('woff2');
		font-weight: 700;
		font-display: swap;
	}
	@font-face {
		font-family: 'Barlow Condensed';
		src: url('/fonts/barlow-condensed-800.woff2') format('woff2');
		font-weight: 800;
		font-display: swap;
	}
	@font-face {
		font-family: 'Barlow';
		src: url('/fonts/barlow-400.woff2') format('woff2');
		font-weight: 400;
		font-display: swap;
	}
	@font-face {
		font-family: 'Barlow';
		src: url('/fonts/barlow-500.woff2') format('woff2');
		font-weight: 500;
		font-display: swap;
	}
	@font-face {
		font-family: 'Barlow';
		src: url('/fonts/barlow-600.woff2') format('woff2');
		font-weight: 600;
		font-display: swap;
	}

	:root {
		color-scheme: light;

		/* "Ledger" system — the brand's own reconciliation concept
		   (reported vs. actual) applied as a visual language across the
		   whole site, not just the blog. Warm paper + ruled lines + ink
		   navy, instead of generic SaaS blue-on-white. */
		--ledger-paper: #f6f1e7;
		--ledger-paper-white: #fffdf9;
		--ledger-white: #ffffff;
		--ledger-ink: #16150f;
		--ledger-navy: #16204a;
		--ledger-navy-light: #2b3a72;
		--ledger-signal: #3355ff;
		--ledger-signal-hover: #2440cc;
		--ledger-signal-pale: #90a8ff;
		--ledger-signal-wash: rgba(51, 85, 255, 0.08);
		--ledger-muted: #8c8368;
		--ledger-rule: #ddd3be;
		--ledger-ink-on-navy: #c9cee3;
		--ledger-good: #2f7a4f;
		--ledger-bad: #a33327;
		--ledger-display: 'Barlow Condensed', 'Avenir Next Condensed', sans-serif;
		--ledger-body: 'Barlow', 'Helvetica Neue', sans-serif;
		--ledger-data: 'Menlo', 'SF Mono', Consolas, 'Roboto Mono', monospace;

		/* Legacy token names, aliased to the Ledger palette so every
		   existing component picks it up without a rewrite. White is the
		   default canvas; the cream paper tone is reserved for banded
		   surfaces (footer, raised sections) so it reads as a deliberate
		   accent instead of tinting the whole page. */
		--color-bg: var(--ledger-white);
		--color-bg-subtle: var(--ledger-paper);
		--color-text: var(--ledger-ink);
		--color-text-muted: var(--ledger-muted);
		--color-border: var(--ledger-rule);
		--color-accent: var(--ledger-signal);
		--color-accent-hover: var(--ledger-signal-hover);
		--radius: 4px;
	}
	* {
		box-sizing: border-box;
	}
	html {
		-webkit-font-smoothing: antialiased;
	}
	body {
		margin: 0;
		font-family: var(--ledger-body);
		background: var(--color-bg);
		color: var(--color-text);
		line-height: 1.6;
	}
	main {
		max-width: 960px;
		margin: 0 auto;
		padding: 3rem 1.5rem;
	}
	h1,
	h2,
	h3 {
		font-family: var(--ledger-display);
		font-weight: 700;
		line-height: 1.15;
		letter-spacing: -0.01em;
		color: var(--ledger-ink);
	}
	p {
		color: var(--color-text-muted);
	}
	a {
		color: var(--color-accent);
	}
	a:hover {
		color: var(--color-accent-hover);
	}
</style>
