---
// Renders nothing until a real, client-cleared case study exists. Wired
// into every money page now so it activates without a rebuild later.
interface CaseStudy {
	title: string;
	summary: string;
	result: string;
	href?: string;
}
interface Props {
	items?: CaseStudy[];
}
const { items = [] } = Astro.props;
---

{
	items.length > 0 && (
		<section class="case-studies">
			<h2>Case Studies</h2>
			<div class="grid">
				{items.map((c) => (
					<div class="card">
						<h3>{c.title}</h3>
						<p>{c.summary}</p>
						<p class="result">{c.result}</p>
						{c.href && (
							<a href={c.href}>
								Read the full case study &rarr;
							</a>
						)}
					</div>
				))}
			</div>
		</section>
	)
}

<style>
	.case-studies {
		padding: 4.5rem 0;
		border-top: 1px solid var(--color-border);
	}
	.case-studies h2 {
		font-size: 1.75rem;
		margin: 0 0 2rem;
	}
	.grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1.75rem;
	}
	.card {
		padding: 1.75rem;
		border: 1px solid var(--color-border);
		border-radius: 12px;
		background: var(--color-bg-subtle);
	}
	.card h3 {
		margin: 0 0 0.6rem;
		font-size: 1.1rem;
	}
	.card p {
		margin: 0 0 0.5rem;
		font-size: 0.95rem;
	}
	.result {
		font-weight: 700;
		color: var(--color-accent);
	}
	.card a {
		display: inline-block;
		margin-top: 0.5rem;
		font-weight: 600;
		text-decoration: none;
		font-size: 0.9rem;
	}

	@media (max-width: 640px) {
		.grid {
			grid-template-columns: 1fr;
		}
	}
</style>
