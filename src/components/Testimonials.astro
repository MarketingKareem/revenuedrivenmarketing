---
// Renders nothing until real testimonials exist. Wired into every money
// page now so it activates the moment real quotes are added, no rebuild
// needed later.
interface Testimonial {
	quote: string;
	name: string;
	title: string;
}
interface Props {
	items?: Testimonial[];
}
const { items = [] } = Astro.props;
---

{
	items.length > 0 && (
		<section class="testimonials">
			<h2>What Clients Say</h2>
			<div class="grid">
				{items.map((t) => (
					<blockquote class="card">
						<p>&ldquo;{t.quote}&rdquo;</p>
						<footer>
							<span class="name">{t.name}</span>
							<span class="title">{t.title}</span>
						</footer>
					</blockquote>
				))}
			</div>
		</section>
	)
}

<style>
	.testimonials {
		padding: 4.5rem 0;
		border-top: 1px solid var(--color-border);
	}
	.testimonials h2 {
		font-size: 1.75rem;
		margin: 0 0 2rem;
	}
	.grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1.75rem;
	}
	.card {
		margin: 0;
		padding: 1.75rem;
		border: 1px solid var(--color-border);
		border-radius: 12px;
		background: var(--color-bg-subtle);
	}
	.card p {
		margin: 0 0 1rem;
		font-size: 1.02rem;
		color: var(--color-text);
	}
	footer {
		display: flex;
		flex-direction: column;
		font-size: 0.9rem;
	}
	.name {
		font-weight: 700;
	}
	.title {
		color: var(--color-text-muted);
	}

	@media (max-width: 640px) {
		.grid {
			grid-template-columns: 1fr;
		}
	}
</style>
