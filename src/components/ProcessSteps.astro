---
const process = [
	{
		step: '01',
		name: 'Audit',
		desc: "We tear the account down to see what's actually happening — tracking accuracy, wasted spend, structural issues the platform dashboard won't show you.",
	},
	{
		step: '02',
		name: 'Rebuild',
		desc: "Fix what's broken first — tracking, structure, targeting — before touching a single bid.",
	},
	{
		step: '03',
		name: 'Scale',
		desc: "Once the foundation is honest, we scale what's proven to convert and cut what isn't.",
	},
];
---

<section class="process">
	<h2>How We Work</h2>
	<div class="grid">
		{
			process.map((p) => (
				<div class="step">
					<span class="step-num">{p.step}</span>
					<h3>{p.name}</h3>
					<p>{p.desc}</p>
				</div>
			))
		}
	</div>
</section>

<style>
	.process {
		padding: 4.5rem 0;
		border-top: 1px solid var(--color-border);
	}
	.process h2 {
		font-size: 1.75rem;
		margin: 0 0 2.5rem;
	}
	.grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.75rem;
	}
	.step-num {
		display: block;
		font-size: 0.85rem;
		font-weight: 800;
		color: var(--color-accent);
		letter-spacing: 0.05em;
		margin-bottom: 0.75rem;
	}
	.step h3 {
		margin: 0 0 0.6rem;
		font-size: 1.15rem;
	}
	.step p {
		margin: 0;
		font-size: 0.95rem;
	}

	@media (max-width: 640px) {
		.grid {
			grid-template-columns: 1fr;
		}
	}
</style>
