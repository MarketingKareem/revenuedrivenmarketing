---
interface Props {
	eyebrow: string;
	title: string;
}
const { eyebrow, title } = Astro.props;
---

<section class="hero">
	<div class="hero-inner">
		<p class="eyebrow">{eyebrow}</p>
		<h1>{title}</h1>
		<p class="lede">
			<slot />
		</p>
		<div class="cta-row">
			<a class="btn primary" href="/contact/">Get a Free Account Audit</a>
			<a class="btn ghost" href="#faq">See Common Questions</a>
		</div>
	</div>
</section>

<style>
	.hero {
		width: auto;
		margin-inline: calc(50% - 50vw);
		margin-top: -3rem;
		background: #0b0d12;
		color: #f5f6fa;
		padding: 5.5rem 1.5rem 5rem;
	}
	.hero-inner {
		max-width: 960px;
		margin: 0 auto;
	}
	.eyebrow {
		text-transform: uppercase;
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		color: #7ba0ff;
		margin: 0 0 1.25rem;
	}
	h1 {
		font-size: 2.75rem;
		max-width: 20ch;
		margin: 0 0 1.5rem;
		color: #fff;
	}
	.lede {
		font-size: 1.2rem;
		max-width: 58ch;
		color: #c2c5d6;
	}
	.cta-row {
		display: flex;
		gap: 1rem;
		margin-top: 2rem;
		flex-wrap: wrap;
	}
	.btn {
		display: inline-block;
		padding: 0.85rem 1.75rem;
		border-radius: var(--radius);
		text-decoration: none;
		font-weight: 700;
		border: 1px solid var(--color-accent);
		color: var(--color-accent);
		transition:
			background 0.15s ease,
			border-color 0.15s ease,
			color 0.15s ease;
	}
	.btn:hover {
		background: var(--color-bg-subtle);
		color: var(--color-accent-hover);
	}
	.btn.primary {
		background: var(--color-accent);
		color: #fff;
	}
	.btn.primary:hover {
		background: var(--color-accent-hover);
		color: #fff;
	}
	.btn.ghost {
		border-color: #454a5e;
		color: #f5f6fa;
	}
	.btn.ghost:hover {
		background: #171922;
		border-color: #7ba0ff;
		color: #fff;
	}

	@media (max-width: 640px) {
		h1 {
			font-size: 2rem;
		}
	}
</style>
