---
const navLinks = [
	{ href: '/', label: 'Home' },
	{ href: '/about/', label: 'About' },
	{ href: '/blog/', label: 'Blog' },
	{ href: '/contact/', label: 'Contact' },
];
const currentPath = Astro.url.pathname;
---

<header class="site-header">
	<div class="wrap">
		<a class="brand" href="/">Revenue Driven Marketing</a>
		<nav>
			{navLinks.map((link) => (
				<a href={link.href} aria-current={currentPath === link.href ? 'page' : undefined}>
					{link.label}
				</a>
			))}
		</nav>
	</div>
</header>

<style>
	.site-header {
		border-bottom: 1px solid #e5e5e5;
	}
	.wrap {
		max-width: 960px;
		margin: 0 auto;
		padding: 1.25rem 1.5rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		flex-wrap: wrap;
	}
	.brand {
		font-weight: 700;
		font-size: 1.1rem;
		color: #111;
		text-decoration: none;
	}
	nav {
		display: flex;
		gap: 1.5rem;
	}
	nav a {
		color: #333;
		text-decoration: none;
		font-size: 0.95rem;
	}
	nav a:hover {
		text-decoration: underline;
	}
	nav a[aria-current='page'] {
		font-weight: 600;
		color: #0a5c36;
	}
</style>
