---
const navLinks = [
	{ href: '/', label: 'Home' },
	{ href: '/ppc-management/', label: 'Services' },
	{ href: '/about/', label: 'About' },
	{ href: '/blog/', label: 'Blog' },
	{ href: '/contact/', label: 'Contact' },
];
const currentPath = Astro.url.pathname;
---

<header class="site-header">
	<div class="wrap">
		<a class="brand" href="/">
			Revenue<span>Driven</span>Marketing
		</a>
		<nav>
			{navLinks.map((link) => (
				<a href={link.href} aria-current={currentPath === link.href ? 'page' : undefined}>
					{link.label}
				</a>
			))}
		</nav>
	</div>
</header>

<style>
	.site-header {
		border-bottom: 1px solid var(--color-border);
	}
	.wrap {
		max-width: 960px;
		margin: 0 auto;
		padding: 1.5rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		flex-wrap: wrap;
	}
	.brand {
		font-weight: 800;
		font-size: 1.1rem;
		letter-spacing: -0.02em;
		color: var(--color-text);
		text-decoration: none;
	}
	.brand span {
		color: var(--color-accent);
	}
	nav {
		display: flex;
		gap: 1.75rem;
	}
	nav a {
		color: var(--color-text-muted);
		text-decoration: none;
		font-size: 0.95rem;
		font-weight: 500;
	}
	nav a:hover {
		color: var(--color-text);
	}
	nav a[aria-current='page'] {
		font-weight: 600;
		color: var(--color-accent);
	}
</style>
