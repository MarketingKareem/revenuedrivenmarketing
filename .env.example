# Copy this file to .env locally, and set the same variables in the
# Cloudflare Pages dashboard (Settings -> Environment variables) for production.

# Google Tag Manager container ID, e.g. GTM-XXXXXXX
PUBLIC_GTM_ID=

# Google Search Console HTML tag verification value (the "content" attribute
# from the meta tag Search Console gives you, not the whole tag)
PUBLIC_GSC_VERIFICATION=
